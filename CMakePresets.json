{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 31, "patch": 0 },
  "configurePresets": [
    {
      "name": "default",
      "displayName": "Aggregate (clang toolchain)",
      "description": "Build every statusbar-* package as one project with the pinned clang/libc++ C++23 toolchain. Use this in your IDE to develop across all submodules at once.",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build",
      "toolchainFile": "${sourceDir}/cmake/toolchain-clang.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "dev",
      "displayName": "Aggregate (clang toolchain, -Werror)",
      "description": "Same as default plus -Werror — the strict dev/CI build (matches local-build.sh).",
      "inherits": "default",
      "cacheVariables": { "ENABLE_WARNINGS_AS_ERRORS": "ON" }
    },
    {
      "name": "gcc",
      "displayName": "Aggregate (gcc toolchain, C++26)",
      "description": "Build every statusbar-* package as one project with GCC 16 and libstdc++ at -std=c++26. Separate build directory from the clang presets: libc++ and libstdc++ objects cannot be mixed.",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build-gcc",
      "toolchainFile": "${sourceDir}/cmake/toolchain-gcc.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "gcc-dev",
      "displayName": "Aggregate (gcc toolchain, C++26, -Werror)",
      "description": "Same as gcc plus -Werror. GCC's diagnostic set differs from clang's, so expect findings the clang build does not report.",
      "inherits": "gcc",
      "binaryDir": "${sourceDir}/build-gcc-dev",
      "cacheVariables": { "ENABLE_WARNINGS_AS_ERRORS": "ON" }
    },
    {
      "name": "asan",
      "displayName": "Aggregate (AddressSanitizer)",
      "description": "The dev build under AddressSanitizer: a read or write outside an object, a use after free and, on Linux, a leak fail the test that does it. Its own build directory; local-build-asan.sh builds and tests it in one command.",
      "inherits": "dev",
      "binaryDir": "${sourceDir}/build-asan",
      "cacheVariables": { "ENABLE_ASAN": "ON" }
    },
    {
      "name": "ubsan",
      "displayName": "Aggregate (UndefinedBehaviorSanitizer)",
      "description": "The dev build under UndefinedBehaviorSanitizer: signed overflow, a misaligned or null access, a shift out of range, an enum or bool with no valid value fail the test that does it. Its own build directory; local-build-ubsan.sh builds and tests it in one command.",
      "inherits": "dev",
      "binaryDir": "${sourceDir}/build-ubsan",
      "cacheVariables": { "ENABLE_UBSAN": "ON" }
    },
    {
      "name": "tsan",
      "displayName": "Aggregate (ThreadSanitizer)",
      "description": "The dev build under ThreadSanitizer: a data race between two threads fails the test that has it. Its own build directory; STATUSBAR_SANITIZER=tsan ./local-build.sh builds and tests it in one command.",
      "inherits": "dev",
      "binaryDir": "${sourceDir}/build-tsan",
      "cacheVariables": { "ENABLE_TSAN": "ON" }
    }
  ],
  "buildPresets": [
    { "name": "default", "configurePreset": "default" },
    { "name": "dev", "configurePreset": "dev" },
    { "name": "gcc", "configurePreset": "gcc" },
    { "name": "gcc-dev", "configurePreset": "gcc-dev" },
    { "name": "asan", "configurePreset": "asan" },
    { "name": "ubsan", "configurePreset": "ubsan" },
    { "name": "tsan", "configurePreset": "tsan" }
  ],
  "testPresets": [
    {
      "name": "default",
      "configurePreset": "default",
      "output": { "outputOnFailure": true },
      "filter": { "exclude": { "label": "functional" } }
    },
    {
      "name": "dev",
      "configurePreset": "dev",
      "output": { "outputOnFailure": true },
      "filter": { "exclude": { "label": "functional" } }
    },
    {
      "name": "gcc",
      "configurePreset": "gcc",
      "output": { "outputOnFailure": true },
      "filter": { "exclude": { "label": "functional" } }
    },
    {
      "name": "gcc-dev",
      "configurePreset": "gcc-dev",
      "output": { "outputOnFailure": true },
      "filter": { "exclude": { "label": "functional" } }
    },
    {
      "name": "asan",
      "configurePreset": "asan",
      "output": { "outputOnFailure": true },
      "filter": { "exclude": { "label": "functional" } }
    },
    {
      "name": "ubsan",
      "configurePreset": "ubsan",
      "output": { "outputOnFailure": true },
      "filter": { "exclude": { "label": "functional" } }
    },
    {
      "name": "tsan",
      "configurePreset": "tsan",
      "output": { "outputOnFailure": true },
      "filter": { "exclude": { "label": "functional" } }
    },
    {
      "name": "default-functional",
      "configurePreset": "default",
      "output": { "outputOnFailure": true },
      "filter": { "include": { "label": "functional" } }
    },
    {
      "name": "dev-functional",
      "configurePreset": "dev",
      "output": { "outputOnFailure": true },
      "filter": { "include": { "label": "functional" } }
    },
    {
      "name": "gcc-functional",
      "configurePreset": "gcc",
      "output": { "outputOnFailure": true },
      "filter": { "include": { "label": "functional" } }
    },
    {
      "name": "gcc-dev-functional",
      "configurePreset": "gcc-dev",
      "output": { "outputOnFailure": true },
      "filter": { "include": { "label": "functional" } }
    },
    {
      "name": "asan-functional",
      "configurePreset": "asan",
      "output": { "outputOnFailure": true },
      "filter": { "include": { "label": "functional" } }
    },
    {
      "name": "ubsan-functional",
      "configurePreset": "ubsan",
      "output": { "outputOnFailure": true },
      "filter": { "include": { "label": "functional" } }
    },
    {
      "name": "tsan-functional",
      "configurePreset": "tsan",
      "output": { "outputOnFailure": true },
      "filter": { "include": { "label": "functional" } }
    }
  ]
}
